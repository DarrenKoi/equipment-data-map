# Optional reference: --prepare-config creates equipment.toml if missing or empty.
# Only these three FTP fields are required before connecting, not before setup.
# The engineer supplies credentials locally; never print this file or its secrets.
# The office agent fills optional defaults with:
#   python spike.py --prepare-config equipment.toml
# Machine facts (proxy URL, token, FTP_TRANSPORT) remain in .env.

[equipment]
host = ""                 # required: FTP IP or hostname
user = ""                 # required: FTP login ID
password = ""             # required: FTP password

# All other settings are optional. Omitted or blank strings get defaults.
# Explicit empty lists and zero budgets are preserved.
# name = "tool"
# port = 21
# roots = ["/"]           # account-visible root; set known narrower roots if available
# deny = []               # glob on basename, root-relative path, or absolute path
# Example values: ["MACFILE_*"] applies to all roots; ["/target-a/MACFILE_*"]
# applies to one root. Both keep MACFILE and skip matching folders and descendants.

# [budget]
# max_dirs = 20           # visited directories, not entries in each listing
# max_download_bytes = 0  # metadata-only start; positive values allow whole-file sampling
# sample_bytes = 8192     # preview size, not an in-flight download cap

# [llm]
# url = ""               # optional approved internal base URL; pair with model
# model = ""             # actual served model/alias; never guessed
# api_key = ""           # optional; never printed
# timeout_s = 60          # per LLM request, not the whole run

# [output]
# dir = "out"            # writes <dir>/<name>/<run-id>/
