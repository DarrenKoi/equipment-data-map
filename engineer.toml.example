# The engineer's answers to the office agent (equipment-data-parser/index.md).
# Copy to engineer.toml at the model folder's root. Only the engineer edits it;
# the agent reads it and never writes it. Fill a table when the agent's
# `waiting` line asks for it: editing this file is what clears that line.
# No password or budget goes here: passwords belong to the OS keystore,
# budgets are defaults in rollout.json that you edit there.

# Letters 16 and 18: the equipment the agent passes to `equipment-map init`.
# Stage 1 points at the fixture server; stage 3 at the real equipment.
# [equipment]
# id = ""               # your own label, e.g. "etch-03"; not a hostname
# host = ""             # FTP IP or hostname
# port = 21
# roots = ["/"]         # only these folders are listed or downloaded from

# Letter 14: skill discovery roots, relative to your home folder.
# [discovery]
# codex = ".codex/skills"
# claude_code = ".claude/skills"
# opencode = ".config/opencode/skills"
# pi = ".pi/agent/skills"

# Letter 15: the synthetic pi export fixtures are in place.
# [export_fixtures]
# inventory_sha256 = ""

# Letter 15: pi passed every scenario on the current release.
# [validation.pi]
# result_sheet_sha256 = ""
# result = "all-scenarios-pass"

# Letters 16-20: the rollout the agent operates. Replace it for the next one.
# [rollout]
# id = ""               # opaque, [a-z0-9][a-z0-9-]{0,31}; not an equipment name
# baseline = ""         # letter 16, later equipment only: rollout that ran stages 1-2
# next_profile = ""     # letter 20: the profiles/<name>.json to register

# Letter 21: one extractor release, between rollouts. Replace it for the next.
# [release]
# id = ""               # opaque, same form as a rollout id
# workbench = ""        # the workbench copy dir that holds attempts.jsonl
# result_sha256 = ""    # the successful attempt to promote
# extractor = ""        # the new extractor's name
