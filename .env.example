# Copy to .env (untracked) and fill in this machine's deployment facts.
# A real environment variable always wins over a value set here.

# Where the firewalled client reaches the FTP proxy.
FTP_PROXY_URL=http://proxy.host:8080

# Bearer token the proxy enforces. Leave empty for the trusted no-auth case.
FTP_PROXY_TOKEN=

# Internal LLM the equipment-map CLI calls at stage 2 onward. `init` copies
# these four into rollout.json; the plan hash covers them from there.
LLM_ENDPOINT=http://llm.host:8000/v1
LLM_MODEL=
LLM_KEY_ALIAS=
LLM_GLOSSARY_PATH=

# Force the proxy on a non-Windows machine that sits behind the firewall.
# Windows always gets the proxy; FTP_TRANSPORT=direct is refused there.
# Leave unset to guess from the OS.
#FTP_TRANSPORT=
